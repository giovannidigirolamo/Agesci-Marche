rules_version = '2';
service cloud.firestore {
  match /databases/{database} {
    match /documents {

      function isSuperAdmin() {
        return request.auth != null && request.auth.token.email == 'comunicazione@marche.agesci.it';
      }

      // Admin "secondari": profilo con isAdmin:true, promossi dal super admin.
      function isAdminOrSuper() {
        return isSuperAdmin() || (request.auth != null &&
          get(/databases/$(database)/documents/profili/$(request.auth.uid)).data.get('isAdmin', false) == true);
      }

      // Documenti Utili
      match /documenti_utili/{documento} {
        allow read: if request.auth != null;
        allow write: if isSuperAdmin();
      }

      // Luoghi e tappe territoriali
      match /luoghi/{document} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if isSuperAdmin();

        match /prenotazioni/{prenotazioneId} {
          allow create: if request.auth != null;
          allow read, delete, update: if isSuperAdmin();
        }
      }

      // Note / segnalazioni sui luoghi
      match /struttura_aggiornamenti/{document} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          (isSuperAdmin() || request.resource.data.status == 'pending');
        allow update, delete: if isSuperAdmin();
      }

      // Profilo utente — "isAdmin" modificabile solo dal superadmin, tutto il resto
      // dal proprietario stesso.
      match /profili/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid &&
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
        allow update: if request.auth != null && (
          (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin'])) ||
          isSuperAdmin()
        );
        allow delete: if isSuperAdmin();
      }

      // NUOVA: Elenco Soci ufficiale, caricato annualmente dal super admin.
      // Mai letto/scritto dal client se non dal super admin; la verifica del codice
      // socio in fase di registrazione avviene lato server con le Admin SDK.
      match /soci_validi/{codiceSocio} {
        allow read, write: if isSuperAdmin();
      }

      // NUOVA: hash delle password degli account via codice socio. MAI accessibile
      // dal client, nemmeno in lettura: solo le funzioni serverless (Admin SDK,
      // bypassano le regole) la toccano.
      match /credenziali_soci/{codiceSocio} {
        allow read, write: if false;
      }

      // Attività regionali e settori
      match /attivita_settori/{document} {
        allow read: if true;
        allow create, update, delete: if isSuperAdmin();

        // Una sola prenotazione per slot (id fisso "unica"), leggibile da chi è
        // autenticato: necessario perché il blocco "già prenotato" valga per tutti.
        match /prenotazioni/{prenotazioneId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && prenotazioneId == 'unica' &&
            !exists(/databases/$(database)/documents/attivita_settori/$(document)/prenotazioni/unica);
          allow update, delete: if isSuperAdmin();
        }
      }

      // Bilanci degli eventi (visibili anche ad admin/gruppo, non solo all'autore)
      match /bilanci_eventi/{document} {
        allow read, write: if request.auth != null;
      }

      // Richieste di Rimborso Spese — dati personali sensibili (IBAN, indirizzo,
      // telefono): visibili e modificabili SOLO da chi le ha create.
      match /rimborsi_spese/{document} {
        allow read, update, delete: if request.auth != null && resource.data.authorEmail == request.auth.token.email;
        allow create: if request.auth != null && request.resource.data.authorEmail == request.auth.token.email;
      }

      // Notizie Home
      match /notizie_home/{document} {
        allow read: if true;
        allow create, update, delete: if isSuperAdmin();
      }

      // NUOVA: Notifiche — ciascuno legge solo quelle "generale", quelle della propria
      // zona/gruppo, o quelle indirizzate a sé. Creabili/eliminabili da admin e superadmin.
      match /notifiche/{document} {
        allow read: if request.auth != null && (
          resource.data.tipo == 'generale' ||
          (resource.data.tipo == 'zona' && resource.data.targetValue == get(/databases/$(database)/documents/profili/$(request.auth.uid)).data.get('zona', null)) ||
          (resource.data.tipo == 'gruppo' && resource.data.targetValue == get(/databases/$(database)/documents/profili/$(request.auth.uid)).data.get('groupName', null)) ||
          (resource.data.tipo == 'singolo' && resource.data.targetValue == request.auth.token.email)
        );
        allow create, update, delete: if isAdminOrSuper();
      }

      // Zone e Gruppi
      match /zone_gruppi/{document} {
        allow read: if true;
        allow create, update, delete: if isSuperAdmin();
      }

      match /settings/{document} {
        allow read: if true;
        allow write: if isSuperAdmin();
      }
    }
  }
}
